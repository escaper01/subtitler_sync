// Submissions, settings, donations and telemetry.
//
// **There are no accounts here, and no money.** There was: an append-only entitlement
// ledger, licence keys, device activations, trials and plans. All of it was removed when
// the product stopped charging — subtitle search is free, and the extension carries no
// credential at all. What is left is the dashboard's own sign-in (`Admin`), the things
// people send us (`Submission`), the levers (`SiteSetting`, `DonationLink`) and enough
// telemetry to see abuse coming (`SearchLog`, `RateLimit`).
//
// One consequence is worth stating where it will be read. **Nothing authenticates the
// search API any more.** The only thing standing in front of `/api/search`, `/api/release`
// and `/api/download` is the rate limiter below, keyed on the extension's anonymous
// install id and a hashed IP. That is why `SearchLog.installId` and `RateLimit` survived a
// removal that took everything around them: they stopped being analytics and became the
// guard. See lib/rateLimit.ts.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in prisma.config.ts
// for the CLI, and reaches the client through a driver adapter — see lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// Who may sign in to /admin.
///
/// A table rather than a comma-separated env var: adding someone should not need a
/// redeploy, and this leaves somewhere to hang per-admin state later. Seeded by
/// prisma/seed.mjs — an empty table locks everyone out, including you.
///
/// This is the *only* kind of account in the system. There is no customer record to be
/// confused with, which is a simplification the removal of the paywall bought.
model Admin {
  id    String  @id @default(cuid())
  /// Lowercased on write. Compared against the verified Google address at sign-in.
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
}

/* ----------------------------------------------------------------- donations */

/// One "support this" button, editable at /admin/donations.
///
/// A table rather than columns on `SiteSetting` because the number of places you can be
/// paid changes over time, and adding PayPal beside Ko-fi should not be a migration.
///
/// `url` is validated by lib/donate.ts#safeUrl on write — http/https only, nothing else.
/// This is not routine hygiene: these URLs are rendered by the extension *inside other
/// people's pages*, so a `javascript:` here would be script execution on every site the
/// extension touches.
model DonationLink {
  id String @id @default(cuid())

  /// `paypal` | `kofi` | `buymeacoffee` | `patreon` | `github` | `liberapay` | `custom`.
  /// Free text: it only picks an icon and a default colour, and an unknown value falls
  /// back to a generic one rather than failing to render.
  provider String
  /// What the button says, e.g. "Buy me a coffee".
  label    String
  url      String

  /// Hidden rather than deleted, so a link can be taken down for a while and put back
  /// without retyping it.
  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The read the public API does: visible links, in order.
  @@index([visible, sortOrder])
}

/* ------------------------------------------------------------------ telemetry */

enum SearchOutcome {
  OK
  /// Turned away by the rate limiter — so the dashboard can see demand it refused. This
  /// used to mean "no subscription"; there are no subscriptions now, and the value was
  /// kept rather than renamed because renaming an enum value that appears in historical
  /// rows is a migration nobody should have to write twice.
  DENIED
  UPSTREAM_ERROR
}

/// One subtitle search.
///
/// Kept through the removal of accounts, and re-pointed at the install id. It answers two
/// questions that still matter without customers: what are people looking for and failing
/// to find, and is one install hammering the API.
model SearchLog {
  /// Autoincrement, not cuid: this is the only high-volume table here, and a 25-byte
  /// random primary key buys nothing while fragmenting the index.
  id BigInt @id @default(autoincrement())

  /// Already normalised by parseQuery — whitespace collapsed, at most 100 characters.
  query    String
  language String
  page     Int

  outcome SearchOutcome
  /// True when the TTL cache answered, which is the only view of real upstream load.
  cached  Boolean       @default(false)
  results Int           @default(0)

  /// Salted SHA-256 of the caller's address. See lib/callerId.ts.
  ipHash String?
  /// The extension's anonymous per-install id. Now the primary way one caller is told from
  /// another, since there is no user to attribute a search to.
  installId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  /// "Which installs are busiest", which is the abuse view.
  @@index([installId, createdAt])
  /// The popular-titles aggregate.
  @@index([query])
}

/// Fixed-window counters.
///
/// In Postgres rather than the in-memory TtlCache because that cache is per-instance and
/// lost on cold start — fine for caching subtitle pages, useless for anything an abuser
/// benefits from resetting.
///
/// This is now the *only* thing limiting who may use the search API. It was a secondary
/// guard behind the licence check; it is the whole guard now.
model RateLimit {
  /// "search:install:<id>:<windowStart>" | "search:ip:<ipHash>:<windowStart>"
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/* ------------------------------------------------------------------- settings */

/// Site settings, as a single row.
///
/// The id is fixed and every write is an upsert, so a second row cannot appear.
///
/// Everything here was once a constant in the code. It moved because each one is something
/// the operator needs to change in response to an event — abuse, cost, a new donation
/// page — and waiting for a deploy to do it is the wrong shape.
model SiteSetting {
  id String @id @default("singleton")

  /// The donation prompt, shown on the site and in the extension panel. The buttons
  /// beneath it are `DonationLink` rows; this is the sentence above them.
  donateEnabled Boolean @default(false)
  donateHeading String  @default("Support the extension")
  donateMessage String  @default("This is free and has no ads. If it saved you an evening, a coffee helps keep the server running.")
  /// Validated `^#[0-9a-fA-F]{6}$` on write — it ends up in inline styles in two codebases,
  /// one of which renders inside other people's pages.
  donateColor   String  @default("#38bdf8")

  /// Request limits, per install. Tighten these when somebody is hammering the API; they
  /// take effect within a minute rather than at the next deploy.
  searchPerHour Int @default(60)
  searchPerDay  Int @default(300)

  updatedAt DateTime @updatedAt
}

/* ---------------------------------------------------------------- submissions */

enum SubmissionKind {
  REPORT
  FEATURE
}

enum SubmissionStatus {
  NEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model Submission {
  id     String           @id @default(cuid())
  kind   SubmissionKind
  status SubmissionStatus @default(NEW)

  /// What they wrote. The only required field.
  message String

  /// Optional: no reply is possible without it, but demanding one suppresses reports.
  email String?

  /// Free-text context the reporter gave — which film, which site.
  subject String?

  /// Filled in automatically when the report comes from the extension.
  extensionVersion String?
  /// The site they were on. Sensitive enough to be worth stating plainly in the UI.
  siteDomain       String?
  /// Anonymous per-install id, so repeated reports from one person can be recognised.
  installId        String?

  /// Admin's own notes, never shown to the submitter.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The queue is read newest-first and filtered by status; both are covered here.
  @@index([status, createdAt])
  @@index([kind, createdAt])
}
