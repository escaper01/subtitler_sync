// Accounts, entitlements, submissions and settings.
//
// Two conventions run through this file and are worth reading before changing anything.
//
// **Entitlement is an append-only ledger with one denormalised cache.** `Entitlement` rows
// are the truth and are never edited or deleted; `User.entitledUntil` is a copy of
// max(endsAt) that exactly one function writes (lib/entitlement.ts#recompute), always in
// the same transaction as the row that changed it. Every paid request reads that one
// column, so the hot path is a single indexed lookup that returns identity and access
// together — not a fold over a ledger.
//
// **There is deliberately no NextAuth PrismaAdapter**, and no Account/Session/
// VerificationToken tables. One provider, no account linking, and the session strategy
// stays `jwt`. The adapter would add three tables and a strategy migration to buy nothing;
// the `User` row is upserted by hand in the signIn callback instead. "We added users, so
// we need the adapter" is the reflex — this is the reason not to.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in prisma.config.ts
// for the CLI, and reaches the client through a driver adapter — see lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// Who may sign in to /admin.
///
/// A table rather than a comma-separated env var: adding someone should not need a
/// redeploy, and this leaves somewhere to hang per-admin state later. Seeded by
/// prisma/seed.mjs — an empty table locks everyone out, including you.
model Admin {
  id    String  @id @default(cuid())
  /// Lowercased on write. Compared against the verified Google address at sign-in.
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
}

/* ------------------------------------------------------------------- accounts */

enum UserStatus {
  ACTIVE
  /// Blocked for abuse. Every token is refused, whatever their entitlement says.
  BANNED
}

enum EntitlementSource {
  TRIAL
  /// Bought through Lemon Squeezy.
  LEMON
  /// Granted by hand from the dashboard.
  ADMIN
}

/// Somebody who has a licence key.
///
/// **There is no sign-in.** A user row is created when someone buys or takes a trial, from
/// the email the payment or the trial form supplied. It exists so one person with two keys
/// is one customer, and so `/admin/users` has something to show — not for authentication.
///
/// Distinct from `Admin`, which is about the dashboard and is the only thing that logs in.
model User {
  id     String     @id @default(cuid())
  /// Lowercased on write. From Lemon Squeezy at purchase, or the trial form.
  email  String     @unique
  name   String?
  image  String?
  status UserStatus @default(ACTIVE)

  /// max(endsAt) over this user's un-revoked entitlements — the only access field read on
  /// the hot path. Written solely by lib/entitlement.ts#recompute.
  ///
  /// Its two null-states carry meaning, and decide which error the API returns:
  ///   null           -> never had access -> 402 no_subscription
  ///   non-null, past -> it ran out       -> 402 subscription_expired
  entitledUntil     DateTime?
  entitlementSource EntitlementSource?

  /// Non-null means the free trial has been used. A column rather than a derived value so
  /// the sign-in path can decide without a second query on the row it just upserted.
  trialGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Bumped at most once a day by the token validator, never per request.
  lastSeenAt DateTime?

  entitlements Entitlement[]
  licenses     License[]
  searches     SearchLog[]

  /// "Who is entitled / expiring this week", and the reconcile sweep.
  @@index([entitledUntil])
  /// The admin user list, newest first.
  @@index([createdAt])
}

/// One granted period of access. Append-only.
///
/// Periods stack rather than replace: a new one starts at `max(now, entitledUntil)`, so
/// redeeming a month on day 2 of a trial gives day 7 to day 37, not day 2 to day 32.
/// Access is max(endsAt) and never a sum, so overlapping rows cannot double-count.
model Entitlement {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   EntitlementSource
  startsAt DateTime          @default(now())
  endsAt   DateTime

  /// Chargebacks and abuse only — *not* cancellation. Someone who cancels keeps the period
  /// they paid for; the absence of the next renewal is what ends their access.
  revokedAt DateTime?
  note      String?
  createdAt DateTime  @default(now())

  /// Trial-once and webhook replay, both enforced by one unique index instead of
  /// hand-written checks:
  ///   trial:<emailHash>
  ///   lemon:<subscriptionId>:<renewsAt>
  ///   admin:<cuid>
  dedupeKey String @unique

  /// The recompute fold: this user's rows, ordered by end date.
  @@index([userId, endsAt])
  /// The reconcile sweep: rows that ended since it last ran.
  @@index([endsAt])
}

/// One row per address that has ever been given the free trial.
///
/// Deliberately unrelated to `User`. Recording "trial used" on the `Entitlement` ledger is
/// not enough: entitlements cascade when an account is deleted, so deleting and signing up
/// again would mint a fresh seven days, forever. This row has no foreign key and so
/// survives that.
///
/// The address is stored as a hash, so an account can be erased without leaving the email
/// behind. Rotating `TRIAL_HASH_SALT` re-opens the trial for everyone — which is a
/// legitimate thing to want, and a surprising thing to do by accident.
model TrialClaim {
  emailHash String   @id
  claimedAt DateTime @default(now())
}

/* ------------------------------------------------------------------- licences */

enum LicenseSource {
  /// Bought through Lemon Squeezy, which generated the key and emailed it to the buyer.
  LEMON
  TRIAL
  /// Issued by hand from the dashboard.
  ADMIN
}

enum LicenseStatus {
  ACTIVE
  /// Chargeback, abuse, or a key the buyer asked to have replaced.
  REVOKED
}

/// The thing a customer pastes into the extension.
///
/// This is the credential — there is no sign-in, and no token of our own. For a purchase
/// the key is Lemon Squeezy's; we only ever see it once, hash it, and recognise it again.
///
/// Whether it *works* is a separate question from whether it exists: validity comes from
/// the owner's `User.entitledUntil`, so a lapsed subscription leaves the key intact and
/// simply stops opening the door. Renewing revives the same key.
model License {
  id String @id @default(cuid())
  /// sha256 of the key. The buyer keeps the only copy; we never need to show it back.
  keyHash String @unique
  /// The first few characters, so a key can be recognised in the dashboard without
  /// storing enough of it to use.
  keyHint String

  source LicenseSource
  status LicenseStatus @default(ACTIVE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lemon Squeezy's own ids, so a renewal or cancellation can find this row again.
  externalId     String? @unique
  subscriptionId String?

  /// Copied from `SiteSetting.defaultDeviceLimit` when the licence is created, rather than
  /// read live — raising or lowering the default must not retroactively lock somebody out
  /// of a device they are already using.
  activationLimit Int @default(2)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  note       String?

  activations LicenseActivation[]

  @@index([userId])
  @@index([subscriptionId])
}

/// One device a licence is being used on.
///
/// A "device" is the extension's anonymous per-install id. The unique constraint below is
/// what enforces the limit: two browsers racing for the last free slot both try to insert,
/// and exactly one succeeds.
model LicenseActivation {
  id        String  @id @default(cuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  installId  String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([licenseId, installId])
  @@index([licenseId])
}

/* ---------------------------------------------------------------------- plans */

enum PlanInterval {
  TRIAL
  MONTH
  YEAR
}

/// What the pricing page offers.
///
/// In the database rather than in code because prices change and a deploy should not be the
/// way to change them — and because the same number written in two places drifts apart.
/// Seeded by prisma/seed.mjs so a fresh install has a working pricing page.
model Plan {
  /// `trial` | `monthly` | `yearly`. Stable, and used in URLs.
  slug String @id
  name String

  /// Cents. Money is never a float.
  priceCents Int
  currency   String       @default("USD")
  interval   PlanInterval
  /// How long one purchase grants. 7 for the trial, 30, 365.
  days Int

  /// The Lemon Squeezy buy link. Empty for the trial, which is handled here.
  checkoutUrl String?
  blurb       String?
  visible     Boolean @default(true)
  sortOrder   Int     @default(0)

  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ telemetry */

enum SearchOutcome {
  OK
  /// Turned away by the gate — so the dashboard can see demand it refused.
  DENIED
  UPSTREAM_ERROR
}

/// One subtitle search. The dashboard's "this user and their queries".
model SearchLog {
  /// Autoincrement, not cuid: this is the only high-volume table here, and a 25-byte
  /// random primary key buys nothing while fragmenting the index.
  id     BigInt  @id @default(autoincrement())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Already normalised by parseQuery — whitespace collapsed, at most 100 characters.
  query    String
  language String
  page     Int

  outcome SearchOutcome
  /// True when the TTL cache answered, which is the only view of real upstream load.
  cached  Boolean       @default(false)
  results Int           @default(0)

  ipHash    String?
  installId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  /// The popular-titles aggregate.
  @@index([query])
}

/// Fixed-window counters.
///
/// In Postgres rather than the in-memory TtlCache because that cache is per-instance and
/// lost on cold start — fine for caching subtitle pages, useless for anything an abuser
/// benefits from resetting.
model RateLimit {
  /// "search:user:<id>:2026-08-09T14" | "redeem:ip:<ipHash>:2026-08-09"
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/* ------------------------------------------------------------------- settings */

/// Site settings, as a single row.
///
/// The id is fixed and every write is an upsert, so a second row cannot appear.
///
/// Everything here was once a constant in the code. It moved because each one is a number
/// the operator needs to change in response to something — abuse, cost, a promotion — and
/// waiting for a deploy to do it is the wrong shape.
model SiteSetting {
  id String @id @default("singleton")

  /// The upgrade prompt, shown to people without a subscription on the site and in the
  /// extension panel.
  promptEnabled Boolean @default(false)
  promptMessage String  @default("Subtitle search keeps a server running. A subscription is what pays for it.")
  /// Validated `^#[0-9a-fA-F]{6}$` on write — it ends up in inline styles in two codebases,
  /// one of which renders inside other people's pages.
  promptColor String  @default("#38bdf8")
  promptUrl   String?

  /// Request limits, per licence. Tighten these when somebody is hammering the API; they
  /// take effect within a minute rather than at the next deploy.
  searchPerHour Int @default(60)
  searchPerDay  Int @default(300)

  /// How many devices a *newly issued* licence may run on. Existing licences keep the
  /// limit they were created with.
  defaultDeviceLimit Int @default(2)

  /// How long the free trial lasts.
  trialDays Int @default(7)

  updatedAt DateTime @updatedAt
}

/* ---------------------------------------------------------------- submissions */

enum SubmissionKind {
  REPORT
  FEATURE
}

enum SubmissionStatus {
  NEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model Submission {
  id     String           @id @default(cuid())
  kind   SubmissionKind
  status SubmissionStatus @default(NEW)

  /// What they wrote. The only required field.
  message String

  /// Optional: no reply is possible without it, but demanding one suppresses reports.
  email String?

  /// Free-text context the reporter gave — which film, which site.
  subject String?

  /// Filled in automatically when the report comes from the extension.
  extensionVersion String?
  /// The site they were on. Sensitive enough to be worth stating plainly in the UI.
  siteDomain String?
  /// Anonymous per-install id, so repeated reports from one person can be recognised.
  installId String?

  /// Admin's own notes, never shown to the submitter.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The queue is read newest-first and filtered by status; both are covered here.
  @@index([status, createdAt])
  @@index([kind, createdAt])
}
