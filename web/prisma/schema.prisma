// Accounts, entitlements, submissions and settings.
//
// Two conventions run through this file and are worth reading before changing anything.
//
// **Entitlement is an append-only ledger with one denormalised cache.** `Entitlement` rows
// are the truth and are never edited or deleted; `User.entitledUntil` is a copy of
// max(endsAt) that exactly one function writes (lib/entitlement.ts#recompute), always in
// the same transaction as the row that changed it. Every paid request reads that one
// column, so the hot path is a single indexed lookup that returns identity and access
// together — not a fold over a ledger.
//
// **There is deliberately no NextAuth PrismaAdapter**, and no Account/Session/
// VerificationToken tables. One provider, no account linking, and the session strategy
// stays `jwt`. The adapter would add three tables and a strategy migration to buy nothing;
// the `User` row is upserted by hand in the signIn callback instead. "We added users, so
// we need the adapter" is the reflex — this is the reason not to.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in prisma.config.ts
// for the CLI, and reaches the client through a driver adapter — see lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// Who may sign in to /admin.
///
/// A table rather than a comma-separated env var: adding someone should not need a
/// redeploy, and this leaves somewhere to hang per-admin state later. Seeded by
/// prisma/seed.mjs — an empty table locks everyone out, including you.
model Admin {
  id    String  @id @default(cuid())
  /// Lowercased on write. Compared against the verified Google address at sign-in.
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
}

/* ------------------------------------------------------------------- accounts */

enum UserStatus {
  ACTIVE
  /// Blocked for abuse. Every token is refused, whatever their entitlement says.
  BANNED
}

enum EntitlementSource {
  TRIAL
  PATREON
  CODE
  /// Granted by hand from the dashboard.
  ADMIN
}

/// Someone who signed in with Google to use subtitle search.
///
/// Distinct from `Admin`, which is about the dashboard. The two are unrelated: an admin
/// who wants to use search has a row in both.
model User {
  id     String     @id @default(cuid())
  /// Lowercased on write, from the *verified* Google address. The identity everywhere.
  email  String     @unique
  name   String?
  image  String?
  status UserStatus @default(ACTIVE)

  /// max(endsAt) over this user's un-revoked entitlements — the only access field read on
  /// the hot path. Written solely by lib/entitlement.ts#recompute.
  ///
  /// Its two null-states carry meaning, and decide which error the API returns:
  ///   null           -> never had access -> 402 no_subscription
  ///   non-null, past -> it ran out       -> 402 subscription_expired
  entitledUntil     DateTime?
  entitlementSource EntitlementSource?

  /// Non-null means the free trial has been used. A column rather than a derived value so
  /// the sign-in path can decide without a second query on the row it just upserted.
  trialGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Bumped at most once a day by the token validator, never per request.
  lastSeenAt DateTime?

  entitlements Entitlement[]
  tokens       ExtensionToken[]
  redemptions  CodeRedemption[]
  searches     SearchLog[]

  /// "Who is entitled / expiring this week", and the reconcile sweep.
  @@index([entitledUntil])
  /// The admin user list, newest first.
  @@index([createdAt])
}

/// One granted period of access. Append-only.
///
/// Periods stack rather than replace: a new one starts at `max(now, entitledUntil)`, so
/// redeeming a month on day 2 of a trial gives day 7 to day 37, not day 2 to day 32.
/// Access is max(endsAt) and never a sum, so overlapping rows cannot double-count.
model Entitlement {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   EntitlementSource
  startsAt DateTime          @default(now())
  endsAt   DateTime

  /// Chargebacks and abuse only — *not* cancellation. Someone who cancels keeps the period
  /// they paid for; the absence of the next renewal is what ends their access.
  revokedAt DateTime?
  note      String?
  createdAt DateTime  @default(now())

  /// Trial-once, webhook replay and double-redeem, all enforced by one unique index
  /// instead of three hand-written checks:
  ///   trial:<emailLower>            (email, not userId — see the note on User)
  ///   patreon:<memberId>:<lastChargeDate>
  ///   code:<codeId>:<userId>
  ///   admin:<cuid>
  dedupeKey String @unique

  /// The recompute fold: this user's rows, ordered by end date.
  @@index([userId, endsAt])
  /// The reconcile sweep: rows that ended since it last ran.
  @@index([endsAt])
}

/// One row per address that has ever been given the free trial.
///
/// Deliberately unrelated to `User`. Recording "trial used" on the `Entitlement` ledger is
/// not enough: entitlements cascade when an account is deleted, so deleting and signing up
/// again would mint a fresh seven days, forever. This row has no foreign key and so
/// survives that.
///
/// The address is stored as a hash, so an account can be erased without leaving the email
/// behind. Rotating `TRIAL_HASH_SALT` re-opens the trial for everyone — which is a
/// legitimate thing to want, and a surprising thing to do by accident.
model TrialClaim {
  emailHash String   @id
  claimedAt DateTime @default(now())
}

/// A long-lived credential the extension sends on every paid request.
///
/// Opaque and random, not a JWT: revocation has to be instant, and the request hits the
/// database for entitlement anyway, so one query returns both. Stored as a SHA-256 hash —
/// see lib/extensionToken.ts for why that is the right hash here and bcrypt is not.
model ExtensionToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256(secret), hex. The secret itself is shown once at mint time and never stored.
  tokenHash String @unique
  /// "Chrome on Windows", from the User-Agent at mint time, so a user can tell two devices
  /// apart on their account page. Never trusted for anything.
  label String?

  createdAt DateTime @default(now())
  /// Written at most once a day, alongside the sliding-expiry bump.
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  /// The account page's device list, and "revoke everything" for one user.
  @@index([userId, createdAt])
  /// The nightly sweep of dead rows.
  @@index([expiresAt])
}

/* ---------------------------------------------------------------------- codes */

/// A redeemable code granting `days` of access.
///
/// Stored in the clear: the admin has to be able to re-read and re-send a supporter's
/// code, and it is the ~60 bits of entropy that makes it unguessable, not secrecy at rest.
/// Redemption is rate limited regardless.
model SubscriptionCode {
  id   String @id @default(cuid())
  /// Uppercase, ambiguity-free alphabet (no O/0/I/1).
  code String @unique
  days Int

  /// 1 = a personal claim code for one supporter. Higher = a campaign code.
  maxRedemptions Int @default(1)
  /// Kept in step with CodeRedemption by a conditional UPDATE inside the redeem
  /// transaction. That compare-and-set, not a read-then-write, is what makes a shared code
  /// impossible to over-redeem under concurrency.
  redemptionCount Int @default(0)

  /// The code stops working. Distinct from the access it granted, which keeps running.
  expiresAt  DateTime?
  disabledAt DateTime?
  note       String?

  createdAt DateTime @default(now())

  pendingGrant PendingGrant?
  redemptions  CodeRedemption[]

  @@index([createdAt])
}

model CodeRedemption {
  id     String           @id @default(cuid())
  codeId String
  code   SubscriptionCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256(ip + IP_HASH_SALT). Abuse review without keeping a table of IP addresses.
  ipHash    String?
  createdAt DateTime @default(now())

  /// One account cannot redeem the same code twice, enforced by the database.
  @@unique([codeId, userId])
  /// "Who used this code, and how fast did it spread."
  @@index([codeId, createdAt])
}

/* -------------------------------------------------------------------- patreon */

enum PendingGrantStatus {
  PENDING
  CLAIMED
  EXPIRED
}

/// A payment we could not attach to an account yet.
///
/// This is the *normal* path, not an edge case: Patreon omits the supporter's email from
/// webhook payloads unless the `campaigns.members[email]` scope was granted, and even with
/// it, the Patreon address is often not the address they sign in with. So a payment always
/// produces something claimable, and nobody pays and gets nothing.
model PendingGrant {
  id     String            @id @default(cuid())
  source EntitlementSource @default(PATREON)

  /// Lowercased, and only when Patreon actually gave us one.
  email String?
  /// Patreon's member id — the one identifier that is always present.
  externalId String
  days       Int

  status          PendingGrantStatus @default(PENDING)
  claimedByUserId String?
  claimedAt       DateTime?

  /// The code the supporter claims it with, created together with this row.
  codeId String?           @unique
  code   SubscriptionCode? @relation(fields: [codeId], references: [id])

  /// Same convention as Entitlement.dedupeKey, so a webhook retry cannot make two.
  dedupeKey String @unique
  /// The raw delivery, for when someone says "I paid and got nothing".
  payload Json

  createdAt DateTime @default(now())

  /// The sign-in path: "is there a grant waiting for this brand-new user's address?"
  @@index([email])
  /// The admin queue: unclaimed grants, oldest first.
  @@index([status, createdAt])
}

/// A Patreon membership, keyed by the id that survives renewals.
model PatreonMember {
  id       String  @id @default(cuid())
  memberId String  @unique
  userId   String?

  email          String?
  tier           String?
  cents          Int?
  active         Boolean   @default(true)
  lastChargeDate DateTime?
  lastEventAt    DateTime  @default(now())

  /// Current patrons, and the ones we could not attach to an account.
  @@index([active, lastEventAt])
  @@index([email])
}

/* ------------------------------------------------------------------ telemetry */

enum SearchOutcome {
  OK
  /// Turned away by the gate — so the dashboard can see demand it refused.
  DENIED
  UPSTREAM_ERROR
}

/// One subtitle search. The dashboard's "this user and their queries".
model SearchLog {
  /// Autoincrement, not cuid: this is the only high-volume table here, and a 25-byte
  /// random primary key buys nothing while fragmenting the index.
  id     BigInt  @id @default(autoincrement())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Already normalised by parseQuery — whitespace collapsed, at most 100 characters.
  query    String
  language String
  page     Int

  outcome SearchOutcome
  /// True when the TTL cache answered, which is the only view of real upstream load.
  cached  Boolean       @default(false)
  results Int           @default(0)

  ipHash    String?
  installId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  /// The popular-titles aggregate.
  @@index([query])
}

/// Fixed-window counters.
///
/// In Postgres rather than the in-memory TtlCache because that cache is per-instance and
/// lost on cold start — fine for caching subtitle pages, useless for anything an abuser
/// benefits from resetting.
model RateLimit {
  /// "search:user:<id>:2026-08-09T14" | "redeem:ip:<ipHash>:2026-08-09"
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/* ------------------------------------------------------------------- settings */

/// Site settings, as a single row.
///
/// The id is fixed and every write is an upsert, so a second row cannot appear. A
/// scheduled, multi-row Announcement model is the growth path; on/off plus a message and a
/// colour is what was asked for, and a singleton is the honest shape for it.
model SiteSetting {
  id String @id @default("singleton")

  donationEnabled Boolean @default(false)
  donationMessage String  @default("This extension is free. If it saved you an evening, consider chipping in.")
  /// Validated `^#[0-9a-fA-F]{6}$` on write — it ends up in inline styles in two codebases,
  /// one of which renders inside other people's pages.
  donationColor String  @default("#38bdf8")
  donationUrl   String?

  updatedAt DateTime @updatedAt
}

/* ---------------------------------------------------------------- submissions */

enum SubmissionKind {
  REPORT
  FEATURE
}

enum SubmissionStatus {
  NEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model Submission {
  id     String           @id @default(cuid())
  kind   SubmissionKind
  status SubmissionStatus @default(NEW)

  /// What they wrote. The only required field.
  message String

  /// Optional: no reply is possible without it, but demanding one suppresses reports.
  email String?

  /// Free-text context the reporter gave — which film, which site.
  subject String?

  /// Filled in automatically when the report comes from the extension.
  extensionVersion String?
  /// The site they were on. Sensitive enough to be worth stating plainly in the UI.
  siteDomain String?
  /// Anonymous per-install id, so repeated reports from one person can be recognised.
  installId String?

  /// Admin's own notes, never shown to the submitter.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The queue is read newest-first and filtered by status; both are covered here.
  @@index([status, createdAt])
  @@index([kind, createdAt])
}
