# Copy to .env and fill in. `.env` is git-ignored; this file is the committed template.
#
#   cp .env.example .env
#
# Next also reads `.env.local`, which wins over `.env` — use it for anything you want to
# override on one machine only.
#
# Two of these you generate rather than fetch from anywhere — NEXTAUTH_SECRET and
# IP_HASH_SALT. Each is just a long random string:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Run it once per variable. Give each its own value: they are unrelated secrets with
# different blast radii, and reusing one means rotating it drags the other with it.
#
# There used to be five more here — TRIAL_HASH_SALT, DEVICE_HASH_SALT,
# ENFORCE_ENTITLEMENT, RESEND_API_KEY and EMAIL_FROM. They went with the paywall: there
# are no trials, no licences, no accounts and no email to send. If you are upgrading an
# existing `.env`, those lines are now ignored and can be deleted.

# --------------------------------------------------------------------- database
# Matches docker-compose.yml. Host port is 5433, not the usual 5432, because 5432 is often
# already taken — a clash there fails as an authentication error against someone else's
# database rather than as "port in use".
#
#   docker compose up -d
#
DATABASE_URL="postgresql://subtitler:subtitler@localhost:5433/subtitler"

# ------------------------------------------------------------------------- auth
# Only /admin signs in. There are no customer accounts — the extension holds no credential
# and never authenticates.
#
# Signs the session cookie. Must be at least 32 characters. Generate your own with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it signs everyone out. Use a different one in production than in development.
NEXTAUTH_SECRET=

# The site's own origin — http://localhost:47821 in development (see docker-compose.yml), your real domain in production.
NEXTAUTH_URL=http://localhost:47821

# Google OAuth client: console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
# Authorised redirect URI must be exactly:  <NEXTAUTH_URL>/api/auth/callback/google
#
# These gate nothing but /admin. Everything else — the site, the search API — runs without
# them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in to /admin is NOT set here — it is the `Admin` table in the database.
# Edit the list in prisma/seed.mjs and run `npm run db:seed`.

# ------------------------------------------------------------------ abuse control
# Salts the stored hash of a caller's IP address.
#
# This matters more than it looks. Nothing authenticates the search API any more, so the
# rate limiter is the only thing in front of it, and it counts against two subjects: the
# extension's install id (which the caller chooses, and can change) and the hash of their
# address (which they cannot). Without a salt the stored hash would be trivially
# reversible — the whole IPv4 space hashes in seconds.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating it only resets abuse history. It is the safe one to change.
IP_HASH_SALT=

# The limits themselves are NOT set here. They are a row in the database, edited at
# /admin/settings, so they can be tightened while somebody is abusing the API rather than
# at the next deploy. The values in lib/settings.ts are only the fallbacks used before that
# row exists.

# ------------------------------------------------------------------- donations
# There is nothing to configure. Donation links are rows in the database, edited at
# /admin/donations — a PayPal, Ko-fi or Buy Me a Coffee URL, added without a deploy.
# There is no payment provider and no checkout; the extension is free.

# ---------------------------------------------------------------------- public
# Your real origin in production. Used to build the absolute links the extension opens.
NEXT_PUBLIC_SITE_URL=http://localhost:47821

# The Web Store listing, once it exists. Every "Add to Chrome" button follows it.
NEXT_PUBLIC_STORE_URL=
