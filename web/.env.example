# Copy to .env.local and fill in. Nothing here is optional except the donate link.

# Postgres. Neon's free tier is enough; Vercel Postgres works too.
# Prisma needs a direct (non-pooled) URL for `migrate`, a pooled one at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth. Must be at least 32 characters, or the app refuses to start:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# The site's own origin. http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID → Web).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may open /admin. Comma-separated; anyone else is refused at sign-in.
ADMIN_EMAILS=you@example.com

# Where the Donate button points. Omit and the button is inert.
NEXT_PUBLIC_DONATE_URL=
