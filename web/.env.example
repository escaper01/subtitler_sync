# Copy to .env and fill in. `.env` is git-ignored; this file is the committed template.
#
#   cp .env.example .env
#
# Next also reads `.env.local`, which wins over `.env` — use it for anything you want to
# override on one machine only.
#
# Four of these you generate rather than fetch from anywhere — NEXTAUTH_SECRET,
# TRIAL_HASH_SALT, IP_HASH_SALT and DEVICE_HASH_SALT. Each is just a long random string:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Run it once per variable. Give each its own value: they are unrelated secrets with
# different blast radii, and reusing one means rotating it drags the other two with it.

# --------------------------------------------------------------------- database
# Matches docker-compose.yml. Host port is 5433, not the usual 5432, because 5432 is often
# already taken — a clash there fails as an authentication error against someone else's
# database rather than as "port in use".
#
#   docker compose up -d
#
DATABASE_URL="postgresql://subtitler:subtitler@localhost:5433/subtitler"

# ------------------------------------------------------------------------- auth
# Signs the session cookie. Must be at least 32 characters. Generate your own with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it signs everyone out. Use a different one in production than in development.
NEXTAUTH_SECRET=

# The site's own origin — http://localhost:3000 in development, your real domain in production.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client: console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
# Authorised redirect URI must be exactly:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in to /admin is NOT set here — it is the `Admin` table in the database.
# Edit the list in prisma/seed.mjs and run `npm run db:seed`.

# ------------------------------------------------------------------- trials
# Salts the stored hash of "this address has had its trial". Changing it hands everyone a
# fresh trial — occasionally what you want, never something to do by accident.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
TRIAL_HASH_SALT=

# How long a trial lasts, and how many devices one key may be used on, are NOT set here.
# They are rows in the database, edited at /admin/settings, so they can change without a
# deploy. The values here are only the fallbacks used before that row exists.

# ---------------------------------------------------------------------- money
# Lemon Squeezy is the shop. It generates the licence key at checkout, emails it to the
# buyer, and expires it when the subscription ends — which is why there is no sign-in.
#
# Store -> Settings -> Webhooks, pointed at <site>/api/webhooks/lemonsqueezy.
# Deliveries are signed HMAC-SHA256 over the raw body; without this every one is refused.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Settings -> API. Used to check a key we have no record of — the missed-webhook recovery
# path. Without it such a key is simply refused, and the customer has to be fixed by hand.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# Sends the trial key. Without it the trial form fails and says so — it does not silently
# consume somebody's one trial.
RESEND_API_KEY=
EMAIL_FROM="Subtitle Synchronizer <noreply@your-domain>"

# Salts the stored hash of a caller's IP. Changing it only resets abuse-detection history,
# so this is the safest of the three to rotate.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
IP_HASH_SALT=

# Salts the stored hash of the device fingerprint taken when someone signs in to the web
# app. Keeps DeviceSignal from being a fingerprint database that could be cross-referenced
# against one collected elsewhere. Changing it orphans the existing rows — duplicate-account
# detection starts over from the next sign-in, and nothing else breaks.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
DEVICE_HASH_SALT=

# Turns the paywall ON. Leave unset until an extension build that sends X-Subtitler-Key
# has actually reached users — enforcing first breaks search for everyone already
# installed, with no way to fix it from the server.
ENFORCE_ENTITLEMENT=false

# ---------------------------------------------------------------------- public
# Your real origin in production. Used to build the links the extension opens (the pricing
# page it sends people to when search is refused).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Web Store listing, once it exists. Every "Add to Chrome" button follows it.
NEXT_PUBLIC_STORE_URL=
