{
  "name": "subtitler-extension-isolated",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overlay SRT/VTT subtitles onto any HTML5 video and find them online, with no server of our own.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node tools/make-icons.mjs",
    "key": "node tools/make-key.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node tools/verify-build.mjs",
    "check": "tsc --noEmit && vitest run && vite build && node tools/verify-build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
